# Copy to ~/.dsh/.credentials.yaml on the Mac.
# DSH normally writes this file itself the first time you sign in /
# connect a client. Prefer letting DSH regenerate it over hand-editing it.
version: 1
records:
  client-connection/browser-session:
    kind: <secret-kind>
    payload:
      version: 1
      secret: <PASTE_BROWSER_SESSION_SECRET_HERE>
